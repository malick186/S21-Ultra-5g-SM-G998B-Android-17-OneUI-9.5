--- /dev/null
+++ b/scripts/internal/check_p3s_boot_metadata.py
@@ -0,0 +1,18 @@
+"""Reject boot/system OS and security-month mismatches before packaging."""
+from pathlib import Path
+import json,struct,sys
+boot,props=map(Path,sys.argv[1:])
+data=boot.read_bytes()
+if data[:8]!=b"ANDROID!" or len(data)<44: raise SystemExit("Invalid Android boot header")
+header=struct.unpack_from("<I",data,40)[0]
+if header!=3: raise SystemExit("Unreviewed p3s boot header version")
+packed=struct.unpack_from("<I",data,16)[0]
+version=((packed>>25)&127,(packed>>18)&127,(packed>>11)&127)
+month=f"{2000+((packed>>4)&127):04d}-{packed&15:02d}"
+properties=dict(line.split("=",1) for line in props.read_text().splitlines() if "=" in line and not line.startswith("#"))
+expected=tuple(map(int,properties["ro.build.version.release"].split(".")))
+expected=expected+(0,)*(3-len(expected))
+security=properties["ro.build.version.security_patch"][:7]
+if version!=expected or month!=security:
+    raise SystemExit(f"Boot/system metadata mismatch: header {version}/{month}, system {expected}/{security}")
+print(json.dumps({"boot_os_version":version,"security_month":month,"matches_system":True}))
