diff --git a/platform/exynos2100/patches/zygote/source/build-helper.sh b/platform/exynos2100/patches/zygote/source/build-helper.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c63f44e3130e60638f45f81de2ab6e50ba494b0b
--- /dev/null
+++ b/platform/exynos2100/patches/zygote/source/build-helper.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+# Rebuild the private ARM64 helper with reviewed Android bionic headers/providers.
+set -euo pipefail
+if [ "$#" -ne 5 ]; then
+    echo "Usage: $0 <pinned-clang> <bionic-source> <donor-libc.so> <donor-libcap.so> <new-output.so>" >&2
+    exit 1
+fi
+compiler="$1"; bionic="$2"; libc="$3"; libcap="$4"; output="$5"
+test ! -e "$output"
+source_dir="$(dirname "$(readlink -f "$0")")"
+resource="$("$compiler" -print-resource-dir)"
+"$compiler" --target=aarch64-linux-android37 -O2 -fPIC -fvisibility=hidden \
+    -fstack-protector-strong -D_FORTIFY_SOURCE=2 -shared -nostdlib -nostdinc \
+    -isystem "$resource/include" -isystem "$bionic/libc/include" \
+    -isystem "$bionic/libc/kernel/uapi" -isystem "$bionic/libc/kernel/uapi/asm-arm64" \
+    -isystem "$bionic/libc/kernel/android/uapi" \
+    "$source_dir/zygote-cap-compat.c" "$libc" "$libcap" \
+    -fuse-ld=lld -Wl,-z,defs,-z,relro,-z,now,-z,noexecstack,-z,max-page-size=16384 \
+    -Wl,--build-id=sha1,-soname,libunica_zygote_cap.so -o "$output"
diff --git a/platform/exynos2100/patches/zygote/source/check-cap-policy.c b/platform/exynos2100/patches/zygote/source/check-cap-policy.c
new file mode 100644
index 0000000000000000000000000000000000000000..36fcd28cbd91119be0e5167fbeb795dcf5b84135
--- /dev/null
+++ b/platform/exynos2100/patches/zygote/source/check-cap-policy.c
@@ -0,0 +1,80 @@
+#include <sepol/policydb/services.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(int argc, char **argv) {
+    if (argc != 2 && argc != 3) return 2;
+    FILE *input = fopen(argv[1], "rb");
+    if (!input || fseek(input,0,SEEK_END)) return 3;
+    long length = ftell(input);
+    if (length < 1 || length > 256*1024*1024 || fseek(input,0,SEEK_SET)) return 3;
+    void *data = malloc((size_t)length);
+    if (!data || fread(data,1,(size_t)length,input)!=(size_t)length) return 3;
+    fclose(input);
+    if (sepol_load_policy(data,(size_t)length)) return 4;
+    unsigned checked_contexts=0, invalid_contexts=0;
+    if (argc == 3) {
+        FILE *labels=fopen(argv[2],"r");
+        if (!labels) return 10;
+        char label[4096];
+        while (fgets(label,sizeof(label),labels)) {
+            size_t length=strlen(label);
+            if (!length || label[length-1]!='\n') return 10;
+            label[length-1]=0;
+            if (!*label) continue;
+            sepol_security_id_t context_sid;
+            ++checked_contexts;
+            if (sepol_context_to_sid(label,strlen(label)+1,&context_sid)) {
+                fprintf(stderr,"Invalid filesystem context: %s\n",label);
+                ++invalid_contexts;
+            }
+        }
+        fclose(labels);
+    }
+    sepol_security_class_t file_class;
+    if (sepol_string_to_security_class("file",&file_class)) return 5;
+    sepol_access_vector_t requested=0,bit=0;
+    const char *permissions[]={"open","read","getattr"};
+    for (unsigned i=0;i<3;++i) {
+        if (sepol_string_to_av_perm(file_class,permissions[i],&bit)) return 5;
+        requested |= bit;
+    }
+    sepol_access_vector_t forbidden=0;
+    const char *forbidden_names[]={"write","append","execute"};
+    for(unsigned i=0;i<3;++i) {
+        if (sepol_string_to_av_perm(file_class,forbidden_names[i],&bit)) return 5;
+        forbidden |= bit;
+    }
+    sepol_security_class_t dir_class;
+    sepol_access_vector_t search=0;
+    if (sepol_string_to_security_class("dir",&dir_class) || sepol_string_to_av_perm(dir_class,"search",&search)) return 5;
+    sepol_security_id_t target;
+    if (sepol_genfs_sid("proc","/sys/kernel/cap_last_cap",file_class,&target)) return 6;
+    char *target_context=0; size_t context_length=0;
+    if (sepol_sid_to_context(target,&target_context,&context_length)) return 6;
+    printf("{\"file_context_labels_checked\":%u,\"invalid_file_context_labels\":%u,\"target_context\":\"%s\",\"domains\":[",checked_contexts,invalid_contexts,target_context);
+    const char *domains[]={"zygote","app_zygote","native_app_zygote","zygote_next","webview_zygote","shell"};
+    for(unsigned i=0;i<sizeof(domains)/sizeof(domains[0]);++i) {
+        char context[128]; snprintf(context,sizeof(context),"u:r:%s:s0",domains[i]);
+        sepol_security_id_t source;
+        if (sepol_context_to_sid(context,strlen(context)+1,&source)) return 7;
+        struct sepol_av_decision decision;
+        if (sepol_compute_av(source,target,file_class,requested|forbidden,&decision)) return 8;
+        int ancestor_search=1;
+        const char *ancestors[]={"/","/sys","/sys/kernel"};
+        for(unsigned ancestor=0;ancestor<3;++ancestor) {
+            sepol_security_id_t dir_sid;
+            struct sepol_av_decision dir_decision;
+            if (sepol_genfs_sid("proc",ancestors[ancestor],dir_class,&dir_sid) ||
+                sepol_compute_av(source,dir_sid,dir_class,search,&dir_decision)) return 8;
+            if ((dir_decision.allowed&search)!=search) ancestor_search=0;
+        }
+        printf("%s{\"domain\":\"%s\",\"open_read_getattr_allowed\":%s,\"write_append_execute_allowed\":%s,\"ancestor_search_allowed\":%s,\"allowed_mask\":%u,\"requested_mask\":%u}",
+            i?",":"",domains[i],(decision.allowed&requested)==requested?"true":"false",
+            (decision.allowed&forbidden)?"true":"false",ancestor_search?"true":"false",decision.allowed,requested);
+    }
+    puts("],\"kernel_runtime_verified\":false}");
+    free(target_context); free(data);
+    return invalid_contexts?9:0;
+}
diff --git a/platform/exynos2100/patches/zygote/source/p3s-cap-boundary.cil b/platform/exynos2100/patches/zygote/source/p3s-cap-boundary.cil
new file mode 100644
index 0000000000000000000000000000000000000000..17f69e5d21bd8c748e11e13ea0831f36ffcda474
--- /dev/null
+++ b/platform/exynos2100/patches/zygote/source/p3s-cap-boundary.cil
@@ -0,0 +1,10 @@
+; Exynos2100 CAP_LAST_CAP is 39. The SDK37 Rust capability enum includes 40.
+; The private helper needs only this public read-only numeric boundary.
+; Do not grant access to generic proc files or capability mutations.
+(type p3s_proc_cap_last_cap)
+(roletype object_r p3s_proc_cap_last_cap)
+(typeattributeset fs_type (p3s_proc_cap_last_cap))
+(typeattributeset proc_type (p3s_proc_cap_last_cap))
+(genfscon proc "/sys/kernel/cap_last_cap" (u object_r p3s_proc_cap_last_cap ((s0) (s0))))
+(allow zygote_next p3s_proc_cap_last_cap (file (getattr open read)))
+(allow native_app_zygote p3s_proc_cap_last_cap (file (getattr open read)))
diff --git a/platform/exynos2100/patches/zygote/source/test-cap-query-contract.c b/platform/exynos2100/patches/zygote/source/test-cap-query-contract.c
new file mode 100644
index 0000000000000000000000000000000000000000..48244375f29c45b4c4b38c707c663e5ae4e25354
--- /dev/null
+++ b/platform/exynos2100/patches/zygote/source/test-cap-query-contract.c
@@ -0,0 +1,70 @@
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int __unica_zygote_cap_get_bound(int capability);
+static const char *mock_text;
+static size_t position, first_limit;
+static int native_result, native_errno, open_failure, interrupt_once, calls, read_calls;
+
+int cap_get_bound(int capability) {
+    (void)capability;
+    ++calls;
+    errno = native_errno;
+    return native_result;
+}
+int test_open(const char *path, int flags, ...) {
+    assert(strcmp(path, "/proc/sys/kernel/cap_last_cap") == 0);
+    assert(flags == (O_RDONLY | O_CLOEXEC));
+    if (open_failure) { errno = EACCES; return -1; }
+    return 17;
+}
+ssize_t test_read(int fd, void *target, size_t requested) {
+    assert(fd == 17);
+    ++read_calls;
+    if (interrupt_once) { interrupt_once = 0; errno = EINTR; return -1; }
+    size_t remaining = strlen(mock_text) - position;
+    size_t amount = remaining < requested ? remaining : requested;
+    if (position == 0 && first_limit && amount > first_limit) amount = first_limit;
+    memcpy(target, mock_text + position, amount);
+    position += amount;
+    return (ssize_t)amount;
+}
+int test_close(int fd) { assert(fd == 17); errno = EBADF; return 0; }
+
+static void check(const char *label, int capability, const char *text,
+                  int query_result, int query_errno, int failed_open,
+                  int interrupted, size_t limit, int expected, int expected_errno) {
+    mock_text = text; position = 0; first_limit = limit;
+    native_result = query_result; native_errno = query_errno;
+    open_failure = failed_open; interrupt_once = interrupted;
+    calls = read_calls = 0; errno = EACCES;
+    int actual = __unica_zygote_cap_get_bound(capability);
+    if (actual != expected || errno != expected_errno || calls != 1) {
+        fprintf(stderr, "%s failed: result=%d errno=%d calls=%d\n", label, actual, errno, calls);
+        _exit(1);
+    }
+    printf("PASS %s\n", label);
+}
+int main(void) {
+    check("unsupported-BPF-query",39,"37\n",-1,EINVAL,0,0,0,0,EACCES);
+    check("unsupported-checkpoint-query",40,"37\n",-1,EINVAL,0,0,0,0,EACCES);
+    check("implemented-error-preserved",37,"37\n",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("outside-pinned-enum-preserved",41,"37\n",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("negative-input-preserved",-1,"37\n",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("permission-error-preserved",39,"37\n",-1,EPERM,0,0,0,-1,EPERM);
+    check("native-success-preserved",36,"37\n",1,ERANGE,0,0,0,1,ERANGE);
+    check("unreadable-proc-preserved",39,"37\n",-1,EINVAL,1,0,0,-1,EINVAL);
+    check("interrupted-read-retried",39,"37\n",-1,EINVAL,0,1,0,0,EACCES);
+    check("trailing-data-rejected",39,"37\nx",-1,EINVAL,0,0,3,-1,EINVAL);
+    check("missing-newline-rejected",39,"37",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("negative-boundary-rejected",39,"-1\n",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("out-of-range-boundary-rejected",39,"64\n",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("empty-boundary-rejected",39,"",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("overlong-boundary-rejected",39,"1234567890123456\n",-1,EINVAL,0,0,0,-1,EINVAL);
+    check("newer-kernel-error-preserved",39,"40\n",-1,EINVAL,0,0,0,-1,EINVAL);
+    return 0;
+}
