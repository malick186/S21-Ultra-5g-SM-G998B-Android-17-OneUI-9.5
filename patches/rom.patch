@@ -0,0 +1,51 @@
+"""Exercise the real ROM fstab adapter against temporary filesystem fixtures."""
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+MODULE = str(Path(__file__).resolve().parents[2] / 'platform/exynos2100/patches/floppy/customize.sh')
+FSTAB = '/dev/block/by-name/userdata /data f2fs noatime wait,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption\n/dev/block/by-name/metadata /metadata ext4 noatime wait,formattable\n'
+
+class EncryptionTests(unittest.TestCase):
+    def test_target_fbe_preserves_vendor_and_updates_ramdisk(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); vendor = d/'vendor'; vendor.write_text(FSTAB)
+            receipt = d/'receipt.json'; receipt.write_text(json.dumps({'userdata_encryption_policy':'target-fbe'}))
+            subprocess.run(['bash',MODULE,'userdata',str(vendor),str(receipt)], check=True, capture_output=True)
+            self.assertEqual(vendor.read_text(), FSTAB)
+            ramdisk = d/'ramdisk'; ramdisk.mkdir()
+            fstab = ramdisk/'fstab.exynos2100'
+            fstab.write_text(FSTAB.replace(',fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption',''))
+            subprocess.run(['bash',MODULE,'fstab',str(ramdisk),str(vendor),str(receipt)], check=True, capture_output=True)
+            self.assertIn('fileencryption=aes-256-xts:aes-256-cts:v2', fstab.read_text())
+            self.assertIn('keydirectory=/metadata/vold/metadata_encryption', fstab.read_text())
+    def test_unknown_policy_rejected_without_writes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=Path(tmp); vendor=d/'vendor'; vendor.write_text(FSTAB)
+            receipt=d/'receipt'; receipt.write_text('{"userdata_encryption_policy":"typo"}')
+            result=subprocess.run(['bash',MODULE,'userdata',str(vendor),str(receipt)],capture_output=True)
+            self.assertNotEqual(result.returncode,0)
+            self.assertEqual(vendor.read_text(),FSTAB)
+    def test_missing_fbe_rejected_without_ramdisk_writes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=Path(tmp); vendor=d/'vendor'; vendor.write_text(FSTAB.replace('fileencryption=', 'unrecognized='))
+            ramdisk=d/'ramdisk'; ramdisk.mkdir(); fstab=ramdisk/'fstab.exynos2100'; fstab.write_text(FSTAB)
+            receipt=d/'receipt'; receipt.write_text('{"userdata_encryption_policy":"target-fbe"}')
+            result=subprocess.run(['bash',MODULE,'fstab',str(ramdisk),str(vendor),str(receipt)],capture_output=True)
+            self.assertNotEqual(result.returncode,0)
+            self.assertEqual(fstab.read_text(),FSTAB)
+
+    def test_vendor_without_fbe_rejected_before_any_write(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=Path(tmp); vendor=d/'vendor'
+            original=FSTAB.replace('fileencryption=', 'unrecognized=')
+            vendor.write_text(original)
+            receipt=d/'receipt'; receipt.write_text('{"userdata_encryption_policy":"target-fbe"}')
+            result=subprocess.run(['bash',MODULE,'userdata',str(vendor),str(receipt)],capture_output=True)
+            self.assertNotEqual(result.returncode,0)
+            self.assertEqual(vendor.read_text(),original)
+
+if __name__ == '__main__':
+    unittest.main()
