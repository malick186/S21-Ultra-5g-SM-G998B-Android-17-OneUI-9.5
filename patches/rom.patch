diff --git a/scripts/internal/normalize_p3s_boot_layout.py b/scripts/internal/normalize_p3s_boot_layout.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb8bd3bea7ed42917143340ddf9272d09e24a244
--- /dev/null
+++ b/scripts/internal/normalize_p3s_boot_layout.py
@@ -0,0 +1,57 @@
+"""Repack p3s vendor_boot with verified Samsung geometry, preserving payloads.
+
+This corrects a demonstrated container mismatch; it does not establish a
+runtime root cause. No kernel code, modules, DTB or encryption policy changes.
+"""
+from pathlib import Path
+import argparse,hashlib,json,shlex,struct,subprocess,tempfile
+
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+def vendor_header(p):
+ b=p.read_bytes()
+ if b[:8]!=b'VNDRBOOT' or len(b)<2112:raise ValueError('Invalid vendor boot')
+ page=struct.unpack_from('<I',b,12)[0];header=struct.unpack_from('<I',b,2096)[0];ramdisk=struct.unpack_from('<I',b,24)[0];dtb=struct.unpack_from('<I',b,2100)[0]
+ if page not in (2048,4096) or header!=2112 or not ramdisk or not dtb:raise ValueError('Unsupported vendor boot sizes')
+ align=lambda n:(n+page-1)//page*page
+ if align(header)+align(ramdisk)+dtb>len(b):raise ValueError('Truncated vendor boot payload')
+ return dict(version=struct.unpack_from('<I',b,8)[0],pagesize=struct.unpack_from('<I',b,12)[0],kernel_addr=struct.unpack_from('<I',b,16)[0],ramdisk_addr=struct.unpack_from('<I',b,20)[0],tags_addr=struct.unpack_from('<I',b,2076)[0],board=b[2080:2096].split(b'\0')[0].decode(),dtb_addr=struct.unpack_from('<Q',b,2104)[0])
+def check_layout(image,reference):
+ actual=vendor_header(image);expected=vendor_header(reference)
+ if actual!=expected:raise ValueError('Samsung vendor_boot layout mismatch: '+json.dumps({'actual':actual,'expected':expected}))
+ return actual
+
+def normalize(work,reference,tools):
+ boot=work/'boot.img';vendor=work/'vendor_boot.img'
+ expected=vendor_header(reference)
+ if expected['version']!=3 or expected['pagesize']!=4096 or expected['kernel_addr']!=0x80008000 or expected['ramdisk_addr']!=0x84000000 or expected['tags_addr']!=0x80000000 or expected['dtb_addr']!=0x81f00000:raise ValueError('Unexpected p3s reference layout')
+ before={n:sha(work/n) for n in ['boot.img','vendor_boot.img']}
+ with tempfile.TemporaryDirectory(prefix='p3s-layout-',dir=work) as temporary:
+  tmp=Path(temporary)
+  args={}
+  for name,image in [('boot',boot),('vendor',vendor)]:
+   destination=tmp/name;destination.mkdir()
+   result=subprocess.run([str(tools/'unpack_bootimg'),'--boot_img',str(image),'--out',str(destination),'--format=mkbootimg'],check=True,capture_output=True,text=True)
+   args[name]=shlex.split(result.stdout)
+  def replace(values,key,value):
+   i=values.index(key);values[i+1]=str(value)
+  v=args['vendor']
+  for key,value in [('pagesize',expected['pagesize']),('base',0),('kernel_offset',expected['kernel_addr']),('ramdisk_offset',expected['ramdisk_addr']),('tags_offset',expected['tags_addr']),('dtb_offset',expected['dtb_addr']),('board',expected['board'])]:replace(v,'--'+key,value)
+  b=args['boot'];line=b[b.index('--cmdline')+1]
+  words=[w for w in line.split() if not w.startswith(('panic=','loglevel=','printk.time='))]
+  words+=['panic=0','loglevel=7','printk.time=1'];replace(b,'--cmdline',' '.join(words))
+  for name,values,flag in [('boot',b,'--output'),('vendor',v,'--vendor_boot')]:
+   new=tmp/(name+'.img')
+   subprocess.run([str(tools/'mkbootimg'),*values,flag,str(new)],check=True)
+   verify=tmp/(name+'-verified');verify.mkdir()
+   subprocess.run([str(tools/'unpack_bootimg'),'--boot_img',str(new),'--out',str(verify)],check=True,capture_output=True)
+   for payload in (['kernel','ramdisk'] if name=='boot' else ['dtb','vendor_ramdisk']):
+    if (tmp/name/payload).read_bytes()!=(verify/payload).read_bytes():raise ValueError('Payload changed: '+name+'/'+payload)
