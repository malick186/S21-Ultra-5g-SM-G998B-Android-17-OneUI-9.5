+"""Reject malformed image labels and source-patch payload leakage."""
+from pathlib import Path
+import re
+import sys
+
+work,output=map(Path,sys.argv[1:])
+errors=[]
+for part in ("system","system/system","system_ext","vendor","product","odm"):
+    for path in (work/part).glob("[0-9][0-9][0-9][0-9]-*.patch"):
+        errors.append("Source patch is not a partition payload: "+str(path.relative_to(work)))
+labels=set()
+files=list((work/"configs").glob("file_context-*"))
+if not files: raise SystemExit("No image file-context metadata was generated")
+for path in files:
+    for number,line in enumerate(path.read_text().splitlines(),1):
+        if not line.strip() or line.lstrip().startswith("#"): continue
+        fields=line.split()
+        valid=len(fields)==2 or (len(fields)==3 and fields[1] in ("--","-b","-c","-d","-p","-l","-s"))
+        if not valid or not re.fullmatch(r"[^:\s]+:object_r:[^:\s]+:s\d+(?::[^\s]+)?(?:-s\d+(?::[^\s]+)?)?",fields[-1]):
+            errors.append(str(path.relative_to(work))+":"+str(number)+": missing/invalid SELinux context")
+        else: labels.add(fields[-1])
+if errors:
+    print("\n".join(errors[:30])); raise SystemExit(1)
+output.parent.mkdir(parents=True,exist_ok=True)
+output.write_text("\n".join(sorted(labels))+"\n")
+print("Image metadata syntax valid; "+str(len(labels))+" unique contexts require final-policy validation")
