+        raise SystemExit("Unexpected static permissive domain: "+str(path))
+output.mkdir(parents=True,exist_ok=True)
+command=[str(compiler),"-m","-M","true","-G","-c","31","-o",str(output/"policy"),"-f",str(output/"file_contexts")]+list(map(str,files))
+result=subprocess.run(command,capture_output=True,text=True)
+(output/"compile.log").write_text(result.stdout+result.stderr)
+report={"strict_policy_compile_passed":result.returncode==0,"exit_code":result.returncode,
+        "neverallow_checks_disabled":False,"static_permissive_domains_found":False,
+        "compiler_sha256":expected,"genfs_labels_version":genfs_version,
+        "genfs_selection_basis":"vendor file or AOSP default; Samsung runtime behavior remains untested",
+        "inputs":{str(p.relative_to(work)):hashlib.sha256(p.read_bytes()).hexdigest() for p in files},
+        "kernel_policy_load_verified":False,"runtime_validated":False}
+(output/"proof.json").write_text(json.dumps(report,indent=2))
+if result.returncode:
