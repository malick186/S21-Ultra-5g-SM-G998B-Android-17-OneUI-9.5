@@ -0,0 +1,33 @@
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+CHECK=ROOT/"scripts/internal/check_p3s_image_metadata.py"
+
+class ImageMetadata(unittest.TestCase):
+    def run_case(self,text,artifact=False):
+        with tempfile.TemporaryDirectory(prefix="p3s-metadata-") as tmp:
+            root=Path(tmp); (root/"configs").mkdir()
+            (root/"configs/file_context-vendor").write_text(text)
+            if artifact:
+                (root/"vendor").mkdir()
+                (root/"vendor/0001-source.patch").write_text("not a ROM payload")
+            output=root/"labels.txt"
+            result=subprocess.run(["python3",str(CHECK),str(root),str(output)],capture_output=True,text=True)
+            return result,output.read_text() if output.exists() else ""
+    def test_valid_metadata_collects_unique_contexts(self):
+        result,labels=self.run_case("/vendor u:object_r:vendor_file:s0\n/vendor/bin -d u:object_r:vendor_file:s0\n")
+        self.assertEqual(result.returncode,0,result.stdout)
+        self.assertEqual(labels,"u:object_r:vendor_file:s0\n")
+    def test_missing_label_is_rejected(self):
+        result,_=self.run_case("/vendor/0001-source.patch \n")
+        self.assertNotEqual(result.returncode,0)
+        self.assertIn("missing/invalid",result.stdout)
+    def test_source_patch_is_rejected_even_with_valid_label(self):
+        result,_=self.run_case("/vendor u:object_r:vendor_file:s0\n",artifact=True)
+        self.assertNotEqual(result.returncode,0)
+        self.assertIn("not a partition payload",result.stdout)
+
+if __name__=="__main__": unittest.main()
