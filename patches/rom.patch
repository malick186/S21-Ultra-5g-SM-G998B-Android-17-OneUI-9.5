index 0000000000000000000000000000000000000000..b5e09bba398f1de48f94ab25af2a464eb50bf08b
--- /dev/null
+++ b/unica/patches/vintf/check_kernel_config.py
@@ -0,0 +1,63 @@
+"""Check only kernel-config requirements in a reference framework matrix.
+
+This does not replace checkvintf or validate HAL/version/instance contracts.
+The build caller supplies the verified original target matrix and compiled config.
+"""
+from pathlib import Path
+import json
+import re
+import xml.etree.ElementTree as ET
+
+def read_config(text):
+    result={}
+    for line in text.splitlines():
+        if line.startswith('CONFIG_') and '=' in line:
+            name,value=line.split('=',1)
+            result[name]=json.loads(value) if value.startswith('"') else value
+        elif line.startswith('# CONFIG_') and line.endswith(' is not set'):
+            result[line[2:-11]]='n'
+    return result
+
+def evaluate(matrix,config,version):
+    actual=tuple(map(int,version.split('-')[0].split('.')))
+    matched=0; checked=0; failures=[]; versions=[]
+    def setting(node):
+        key=node.findtext('key'); value=node.find('value')
+        if value is None or value.get('type') not in ('tristate','string'):
+            raise ValueError('Unsupported matrix config value; do not silently pass it')
+        return key,value.text or '',config.get(key,'n')
+    for kernel in matrix.findall('kernel'):
+        required=tuple(map(int,kernel.get('version').split('.')))
+        if required[:2]!=actual[:2]:
+            continue
+        versions.append(required)
+        conditions=[setting(c) for c in kernel.findall('conditions/config')]
+        if not all(expected==observed for _,expected,observed in conditions):
+            continue
+        matched+=1
+        if actual<required:
+            failures.append({'minimum_version':'.'.join(map(str,required)),'actual_version':version})
+        for entry in kernel.findall('config'):
+            key,expected,observed=setting(entry); checked+=1
+            if expected!=observed:
+                failures.append({'key':key,'required':expected,'actual':observed})
+    if not versions or not matched:
+        raise ValueError('No applicable reference kernel requirements')
+    return {'applicable_kernel_blocks':matched,'config_requirements_checked':checked,
+            'failures':failures,'reference_kernel_config_requirements_passed':not failures,
+            'full_vintf_compatibility_verified':False}
+
+if __name__ == '__main__':
+    import hashlib
+    import sys
+    if len(sys.argv) != 4:
+        raise SystemExit('Usage: check_kernel_config.py MATRIX ACTUAL_CONFIG KERNEL_RECEIPT')
+    matrix, config, receipt = map(Path, sys.argv[1:])
+    record = json.loads(receipt.read_text())
+    expected = record.get('source_inputs', {}).get('expected_resolved_config_sha256')
+    if not expected or hashlib.sha256(config.read_bytes()).hexdigest() != expected:
+        raise SystemExit('Compiled kernel config provenance mismatch; do not use embedded stock IKCONFIG')
+    report = evaluate(ET.parse(matrix).getroot(), read_config(config.read_text()), record['compiled_release'])
+    print(json.dumps(report, indent=2))
+    if not report['reference_kernel_config_requirements_passed']:
+        raise SystemExit('Actual compiled kernel does not satisfy the target matrix; preserve the requirements and fix the kernel profile')
