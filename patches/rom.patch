+"""Exercise the retained C helper, with mocks only for native capability/proc I/O."""
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+
+class ZygoteCapabilityContract(unittest.TestCase):
+    def test_private_query_preserves_native_errors(self):
+        compiler=shutil.which("clang") or shutil.which("cc")
+        self.assertIsNotNone(compiler,"A host C compiler is required")
+        source=ROOT/"platform/exynos2100/patches/zygote/source"
+        with tempfile.TemporaryDirectory(prefix="p3s-cap-test-") as tmp:
+            executable=Path(tmp)/"test-cap-query"
+            subprocess.run([compiler,"-D_GNU_SOURCE","-O2","-Wall","-Wextra","-Werror",
+                "-Dopen=test_open","-Dread=test_read","-Dclose=test_close",
+                str(source/"zygote-cap-compat.c"),str(source/"test-cap-query-contract.c"),
+                "-o",str(executable)],check=True,capture_output=True,text=True)
+            result=subprocess.run([str(executable)],check=True,capture_output=True,text=True)
+            lines=result.stdout.splitlines()
+            self.assertEqual(len(lines),16)
+            self.assertTrue(all(line.startswith("PASS ") for line in lines))
+
+if __name__=="__main__": unittest.main()
