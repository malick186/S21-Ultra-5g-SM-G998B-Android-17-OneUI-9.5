+"""Pin reviewed p3s top-level and signed chained AVB metadata separately."""
+from pathlib import Path
+import hashlib,json,struct,sys
+ROOT='f111567249c567e73230fedbfc768c3b8398568de9efbb027f72d39b98ac619e'
+CHILD='5be409f10bace1c3bf68410ae48f9fa3f978750640a44f204d4817c687e7338f'
+def validate(root,child):
+ for name,data in [('vbmeta',root),('vbmeta_system',child)]:
+  if len(data)!=65536 or data[:4]!=b'AVB0':raise ValueError('Missing/truncated AVB metadata: '+name)
+ if struct.unpack_from('>I',root,120)[0]!=2 or struct.unpack_from('>I',root,28)[0]!=0:raise ValueError('Unreviewed top-level verification profile')
+ if struct.unpack_from('>I',child,120)[0]!=0:raise ValueError('Chained AVB image must have zero flags')
+ if hashlib.sha256(root).hexdigest()!=ROOT:raise ValueError('Top-level image differs from reviewed known-working profile')
+ if hashlib.sha256(child).hexdigest()!=CHILD:raise ValueError('Chained signed image differs from original stock reference')
+ return {'top_level_flags':2,'top_level_algorithm':'NONE','chained_flags':0,'exact_chained_stock_signature_preserved':True,'runtime_boot_certified':False}
+if __name__=='__main__':
+ directory=Path(sys.argv[1]);print(json.dumps(validate((directory/'vbmeta.img').read_bytes(),(directory/'vbmeta_system.img').read_bytes())))
diff --git a/scripts/internal/check_p3s_boot_metadata.py b/scripts/internal/check_p3s_boot_metadata.py
