+"""Exercise the full VINTF module in temporary build-input fixtures."""
+from pathlib import Path
+import os
+import json
+import hashlib
+import subprocess
+import tempfile
+import unittest
+
+MODULE=str(Path(__file__).resolve().parents[2]/'unica/patches/vintf/customize.sh')
+class VintfTests(unittest.TestCase):
+    def run_module(self,root,missing=False,existing=False,level='5', require_cfi=False, wrong_hash=False):
+        work=root/'work'; firmware=root/'fw/SM-G998B_AUT/system/system/etc/vintf'
+        (work/'vendor/etc/vintf').mkdir(parents=True)
+        (work/'vendor/etc/vintf/manifest.xml').write_text('<manifest version="2.0" type="device" target-level="'+level+'"/>')
+        target=root/'src/target/p3s/vintf'; target.mkdir(parents=True)
+        (target/'compatibility_matrix.device.xml').write_text('<compatibility-matrix version="9.0" type="framework"/>')
+        dest=work/'system/system/etc/vintf'; dest.mkdir(parents=True)
+        matrix='<compatibility-matrix version="9.0" type="framework" level="5"><kernel version="5.4.61"/></compatibility-matrix>'
+        if require_cfi:
+            matrix=matrix.replace('/></compatibility-matrix>', '><config><key>CONFIG_CFI_CLANG</key><value type="tristate">y</value></config></kernel></compatibility-matrix>')
+        kernel=work/'kernel'; kernel.mkdir()
+        cfg='# CONFIG_CFI_CLANG is not set\nCONFIG_ARM64=y\n'
+        (kernel/'kernel.config').write_text(cfg)
+        receipt={'compiled_release':'5.4.304-test','source_inputs':{'expected_resolved_config_sha256':
+                 '0'*64 if wrong_hash else hashlib.sha256(cfg.encode()).hexdigest()}}
+        (kernel/'floppy-preserved.json').write_text(json.dumps(receipt))
+        if not missing:
+            firmware.mkdir(parents=True)
+            (firmware/'compatibility_matrix.5.xml').write_text(matrix)
+        if existing:
+            (dest/'compatibility_matrix.5.xml').write_text('preserve different matrix')
+        environment=os.environ|{'SOURCE_PLATFORM_SDK_VERSION':'37','TARGET_PLATFORM_SDK_VERSION':'35',
+            'TARGET_CODENAME':'p3s','TARGET_FIRMWARE':'SM-G998B/AUT','SRC_DIR':str(root/'src'),
+            'WORK_DIR':str(work),'FW_DIR':str(root/'fw'),'DEBUG':'false','MODPATH':str(Path(MODULE).parent)}
+        script='''set -e
+ABORT() { echo "$*" >&2; exit 23; }
+LOG() { :; }
+LOGW() { :; }
+EVAL() { eval "$*"; }
+ADD_TO_WORK_DIR() { mkdir -p "$WORK_DIR/system/$(dirname "$3")"; if [[ "$1" = /* ]]; then cp "$1/$3" "$WORK_DIR/system/$3"; else cp "$FW_DIR/SM-G998B_AUT/system/$3" "$WORK_DIR/system/$3"; fi; }
+source "$1"
+'''
+        result=subprocess.run(['bash','-c',script,'test',MODULE],env=environment,capture_output=True,text=True)
+        return result,dest,matrix
+    def test_restores_exact_original_contract(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result,dest,matrix=self.run_module(Path(tmp))
+            self.assertEqual(result.returncode,0,result.stderr)
+            self.assertEqual((dest/'compatibility_matrix.5.xml').read_text(),matrix)
+    def test_missing_original_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result,dest,_=self.run_module(Path(tmp),missing=True)
+            self.assertNotEqual(result.returncode,0)
+            self.assertFalse((dest/'compatibility_matrix.5.xml').exists())
+    def test_existing_different_matrix_preserved(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result,dest,_=self.run_module(Path(tmp),existing=True)
+            self.assertNotEqual(result.returncode,0)
+            self.assertEqual((dest/'compatibility_matrix.5.xml').read_text(),'preserve different matrix')
+    def test_unreviewed_vendor_level_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result,dest,_=self.run_module(Path(tmp),level='6')
+            self.assertNotEqual(result.returncode,0)
+            self.assertFalse((dest/'compatibility_matrix.5.xml').exists())
+    def test_actual_disabled_cfi_blocks_matrix_staging(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result,dest,_=self.run_module(Path(tmp),require_cfi=True)
+            self.assertNotEqual(result.returncode,0)
+            self.assertFalse((dest/'compatibility_matrix.5.xml').exists())
+    def test_changed_kernel_config_is_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result,dest,_=self.run_module(Path(tmp),wrong_hash=True)
+            self.assertNotEqual(result.returncode,0)
+            self.assertFalse((dest/'compatibility_matrix.5.xml').exists())
+if __name__=='__main__':
+    unittest.main()
