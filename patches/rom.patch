+files=[]
+for part,name in (("system","plat_sepolicy.cil"),("system_ext","system_ext_sepolicy.cil"),("product","product_sepolicy.cil")):
+    policy=parts[part]/name
+    if policy.exists(): files.append(policy)
+    elif part!="product": raise SystemExit("Missing required split policy: "+str(policy))
+    mapping=parts[part]/"mapping"/(version+".cil")
+    if mapping.exists(): files.append(mapping)
+    elif part!="product": raise SystemExit("Missing original API30 mapping: "+str(mapping))
+    compat=parts[part]/"mapping"/(version+".compat.cil")
+    if part!="product" and compat.exists(): files.append(compat)
+files += [parts["vendor"]/"plat_pub_versioned.cil",parts["vendor"]/"vendor_sepolicy.cil"]
+odm=parts["odm"]/"odm_sepolicy.cil"
+if odm.exists(): files.append(odm)
+genfs_file=parts["vendor"]/"genfs_labels_version.txt"
+genfs_version=202404
+if genfs_file.exists():
+    try: genfs_version=int(genfs_file.read_text().strip())
+    except ValueError: pass  # AOSP libgenfslabelsversion default for invalid/missing content.
+genfs=parts["system"]/("plat_sepolicy_genfs_"+str(genfs_version)+".cil")
+if genfs.exists(): files.append(genfs)
