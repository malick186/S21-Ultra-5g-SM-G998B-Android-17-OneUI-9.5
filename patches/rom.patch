diff --git a/scripts/internal/prepare_p3s_apex_vintf.py b/scripts/internal/prepare_p3s_apex_vintf.py
new file mode 100644
index 0000000000000000000000000000000000000000..38239bc0985c50d91e857e9576c422fa957d10dd
--- /dev/null
+++ b/scripts/internal/prepare_p3s_apex_vintf.py
@@ -0,0 +1,59 @@
+from pathlib import Path
+import hashlib,json,shutil,struct,subprocess,tempfile,zipfile,sys
+import xml.etree.ElementTree as ET
+base=Path(__file__).resolve().parents[2].parent
+work,out=map(Path,sys.argv[1:])
+if out.exists(): raise SystemExit('Existing APEX inventory retained')
+out.mkdir()
+tree=ET.Element('apex-info-list'); rows=[]; names=set()
+def varint(data,pos):
+    value=0; shift=0
+    while True:
+        b=data[pos]; pos+=1; value|=(b&127)<<shift
+        if b<128: return value,pos
+        shift+=7
+def manifest(data):
+    pos=0; result={}
+    while pos<len(data):
+        tag,pos=varint(data,pos); field,wire=tag>>3,tag&7
+        if wire==0: value,pos=varint(data,pos)
+        elif wire==2:
+            n,pos=varint(data,pos); value=data[pos:pos+n]; pos+=n
+        elif wire==1: pos+=8; continue
+        elif wire==5: pos+=4; continue
+        else: raise ValueError('Unknown manifest wire type')
+        if field in (1,2,5): result[field]=value
+    return result
+for part,directory in [('SYSTEM',work/'system/system'),('SYSTEM_EXT',work/'system/system/system_ext'),('PRODUCT',work/'product'),('VENDOR',work/'vendor'),('ODM',work/'odm')]:
+    for package in sorted((directory/'apex').glob('*')):
+        if package.suffix not in ('.apex','.capex'): continue
+        with tempfile.TemporaryDirectory(prefix='apex-',dir=out) as temporary:
+            tmp=Path(temporary)
+            with zipfile.ZipFile(package) as outer:
+                if 'original_apex' in outer.namelist():
+                    with outer.open('original_apex') as src,(tmp/'original.apex').open('wb') as dst: shutil.copyfileobj(src,dst,4*1024*1024)
+                    archive=zipfile.ZipFile(tmp/'original.apex')
+                else: archive=outer
+                fields=manifest(archive.read('apex_manifest.pb'))
+                name=fields[1].decode(); version=fields[2]
+                if '/' in name or name in names: raise SystemExit('Unsafe or duplicate APEX module: '+name)
+                names.add(name)
+                with archive.open('apex_payload.img') as src,(tmp/'payload.img').open('wb') as dst: shutil.copyfileobj(src,dst,4*1024*1024)
+                if archive is not outer: archive.close()
+            dest=out/name/'etc/vintf'; dest.mkdir(parents=True)
+            with (tmp/'payload.img').open('rb') as f: f.seek(1024); magic=f.read(64)
+            if magic[:4]==bytes.fromhex('e2e1f5e0'):
+                subprocess.run([str(base/'source/out/tools/bin/fsck.erofs'),'--extract='+str(tmp/'fs'),str(tmp/'payload.img')],check=True,capture_output=True)
+                if (tmp/'fs/etc/vintf').exists(): shutil.copytree(tmp/'fs/etc/vintf',dest,dirs_exist_ok=True)
+            elif magic[56:58]==bytes.fromhex('53ef'):
+                result=subprocess.run(['debugfs','-R','rdump /etc/vintf '+str(dest),str(tmp/'payload.img')],capture_output=True,text=True)
+                if result.returncode: raise SystemExit(result.stderr)
+                if result.stderr.strip() and 'File not found by ext2_lookup' not in result.stderr and len(result.stderr.splitlines())>1:
+                    raise SystemExit(result.stderr)
+            else: raise SystemExit('Unrecognized APEX filesystem: '+str(package))
+            path='/'+part.lower()+'/apex/'+package.name
+            ET.SubElement(tree,'apex-info',moduleName=name,modulePath=path,preinstalledModulePath=path,versionCode=str(version),versionName='',isFactory='true',isActive='true',lastUpdateMillis='0',partition=part)
+            rows.append({'package':str(package.relative_to(work)),'sha256':hashlib.sha256(package.read_bytes()).hexdigest(),'module':name,'version':version,'partition':part,'vintf_files':[str(p.relative_to(out)) for p in dest.rglob('*') if p.is_file()]})
+            print(name+' '+str(len(rows[-1]['vintf_files']))+' VINTF files',flush=True)
+ET.ElementTree(tree).write(out/'apex-info-list.xml',encoding='utf-8',xml_declaration=True)
+(out/'inventory.json').write_text(json.dumps(rows,indent=2))
